# ─────────────────────────────────────────────────────────────────
# JARVIS Hand Gesture Control System — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Camera ────────────────────────────────────────────────────────
# Index of the webcam to use (0 = default system camera)
CAMERA_INDEX=0

# ── Screen Resolution ─────────────────────────────────────────────
# Must match your actual display resolution for correct cursor mapping
SCREEN_WIDTH=1920
SCREEN_HEIGHT=1080

# ── Gesture Fusion ────────────────────────────────────────────────
# Minimum combined confidence to trigger a voice+gesture fusion action (0.0–1.0)
FUSION_THRESHOLD=0.72
# Maximum milliseconds between voice token and gesture for fusion to apply
FUSION_TIME_WINDOW_MS=1200

# ── Voice / Whisper ───────────────────────────────────────────────
# Whisper model size: tiny | base | small | medium | large
# tiny = fastest, least accurate | large = slowest, most accurate
WHISPER_MODEL=tiny

# ── Analytics Dashboard ───────────────────────────────────────────
# Port the Flask dashboard listens on
DASHBOARD_PORT=5050
# Automatically open browser when dashboard starts
DASHBOARD_AUTO_OPEN=true

# ── Virtual Camera ────────────────────────────────────────────────
# Backend for pyvirtualcam: auto | obs | v4l2 | unitycapture
VIRTUAL_CAMERA_BACKEND=auto

# ── Debug & Logging ───────────────────────────────────────────────
# Enable extra debug overlays and verbose console output
DEBUG_MODE=false
# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Cursor Behaviour ──────────────────────────────────────────────
# Pixels of movement below which cursor update is suppressed (jitter filter)
DEAD_ZONE_PX=10
# EMA smoothing weight for cursor position (0.0=frozen, 1.0=raw, 0.35=default)
SMOOTHING_ALPHA=0.35
# Normalised horizontal velocity threshold to trigger a swipe gesture
SWIPE_THRESHOLD=0.13
# Speed multiplier applied in Precision Mode (fine control)
PRECISION_SENSITIVITY=0.55
# Speed multiplier applied in Presentation Mode (large gestures)
PRESENTATION_SENSITIVITY=1.9

# ── File Paths ────────────────────────────────────────────────────
# Path to hand calibration JSON produced by the calibration wizard
CALIBRATION_FILE=config/hand_calibration.json
# Directory where air-drawing saves PNGs
DRAWING_SAVE_PATH=drawings/
# SQLite database for gesture analytics and session history
DB_PATH=data/gesture_analytics.db
